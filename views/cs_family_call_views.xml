<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="cs_family_call_view_list" model="ir.ui.view">
            <field name="name">cs.family.call.list</field>
            <field name="model">cs.family.call</field>
            <field name="arch" type="xml">
                <list string="Contactos con familia">
                    <field name="name"/>
                    <field name="call_datetime"/>
                    <field name="resident_id"/>
                    <field name="contacted_name"/>
                    <field name="relationship"/>
                    <field name="channel"/>
                    <field name="outcome"/>
                    <field name="staff_id"/>
                </list>
            </field>
        </record>

        <record id="cs_family_call_view_form" model="ir.ui.view">
            <field name="name">cs.family.call.form</field>
            <field name="model">cs.family.call</field>
            <field name="arch" type="xml">
                <form string="Contacto con familia">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Residente">
                                <field name="resident_id"/>
                                <field name="partner_id"/>
                                <field name="call_datetime"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group string="Contacto">
                                <field name="contacted_name"/>
                                <field name="relationship"/>
                                <field name="channel"/>
                                <field name="duration_minutes"/>
                                <field name="outcome"/>
                                <field name="staff_id"/>
                            </group>
                        </group>
                        <group string="Notas">
                            <field name="notes" nolabel="1" colspan="2"/>
                        </group>
                        <group string="Archivos adjuntos (PDF, imágenes, etc.)">
                            <field name="attachment_ids" nolabel="1" colspan="2" widget="many2many_binary"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="cs_family_call_view_search" model="ir.ui.view">
            <field name="name">cs.family.call.search</field>
            <field name="model">cs.family.call</field>
            <field name="arch" type="xml">
                <search string="Contactos familia">
                    <field name="name"/>
                    <field name="resident_id"/>
                    <field name="contacted_name"/>
                    <separator/>
                    <filter name="phone" string="Teléfono" domain="[('channel', '=', 'phone')]"/>
                </search>
            </field>
        </record>

        <record id="cs_family_call_action" model="ir.actions.act_window">
            <field name="name">Contactos con familia</field>
            <field name="res_model">cs.family.call</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
