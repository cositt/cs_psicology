<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="cs_resident_psychology_form_extend" model="ir.ui.view">
            <field name="name">cs.resident.form.psychology.extend</field>
            <field name="model">cs.resident</field>
            <field name="inherit_id" ref="cs_resident.resident_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_open_psychology_sessions"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-user-md">
                        <field name="psychology_session_count" widget="statinfo" string="Psicología"/>
                    </button>
                </xpath>
                <xpath expr="//group[@name='resident_notes_group']" position="after">
                    <group string="Psicología — Llamadas y contactos familiares">
                        <field name="family_call_ids" nolabel="1">
                            <list string="Llamadas familiares" editable="bottom">
                                <field name="call_datetime"/>
                                <field name="family_partner_id"/>
                                <field name="contacted_name"/>
                                <field name="relationship"/>
                                <field name="channel"/>
                                <field name="outcome"/>
                                <field name="staff_id"/>
                                <field name="duration_minutes"/>
                                <field name="notes" optional="hide"/>
                            </list>
                        </field>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
