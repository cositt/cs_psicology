<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="calendar_event_view_form_psychology" model="ir.ui.view">
            <field name="name">calendar.event.form.psychology</field>
            <field name="model">calendar.event</field>
            <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='location']" position="after">
                    <field name="cs_is_psychology_visit"/>
                    <group string="Centro Sanitario — Psicología" invisible="not cs_is_psychology_visit">
                        <field name="cs_psychology_session_id" readonly="1"/>
                        <field name="cs_resident_id"/>
                        <field name="cs_residence_id"/>
                        <field name="cs_room_id"/>
                        <field name="cs_psychologist_worker_id"/>
                        <field name="cs_visit_mode"/>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="view_calendar_event_search_psychology" model="ir.ui.view">
            <field name="name">calendar.event.search.psychology</field>
            <field name="model">calendar.event</field>
            <field name="inherit_id" ref="calendar.view_calendar_event_search"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='recurrent']" position="before">
                    <filter string="Psicología" name="cs_psychology_visits" domain="[('cs_is_psychology_visit', '=', True)]"/>
                    <separator/>
                </xpath>
                <xpath expr="//field[@name='location']" position="after">
                    <field name="cs_resident_id"/>
                    <field name="cs_psychologist_worker_id"/>
                </xpath>
            </field>
        </record>

        <record id="cs_psychology_calendar_action" model="ir.actions.act_window">
            <field name="name">Citas de psicología</field>
            <field name="res_model">calendar.event</field>
            <field name="view_mode">calendar,list,form</field>
            <field name="view_id" ref="calendar.view_calendar_event_calendar"/>
            <field name="search_view_id" ref="calendar.view_calendar_event_search"/>
            <field name="domain">[('cs_is_psychology_visit', '=', True)]</field>
            <field name="context">{'default_cs_is_psychology_visit': True, 'default_show_as': 'busy', 'default_privacy': 'confidential'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Planifique una visita de psicología.
                </p>
                <p>
                    Las sesiones planificadas desde «Sesiones» crean o actualizan la cita en el calendario nativo.
                </p>
            </field>
        </record>
    </data>
</odoo>
